{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chatgpt-github-coordinator/approval-state.schema.json",
  "title": "Approval State",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "mode", "status"],
  "properties": {
    "gate": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["explicit", "disabled"] },
    "status": { "type": "string", "enum": ["approved", "rejected", "missing", "ambiguous", "not-required"] },
    "approver": { "type": "string" },
    "approvalText": { "type": "string" },
    "evidenceRef": { "type": "string" },
    "evaluatedAt": { "type": "string", "format": "date-time" }
  }
}

