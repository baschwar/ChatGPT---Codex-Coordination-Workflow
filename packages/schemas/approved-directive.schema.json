{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chatgpt-github-coordinator/approved-directive.schema.json",
  "title": "Approved Directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "background",
    "approvedScope",
    "constraints",
    "acceptanceCriteria",
    "requiredAutomatedTests",
    "requiredManualTests",
    "documentationRequirements",
    "exclusions",
    "dependencies",
    "validationRequirements",
    "humanApprovalGates"
  ],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "background": { "type": "string", "minLength": 1 },
    "approvedScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requiredAutomatedTests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requiredManualTests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "documentationRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "exclusions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "validationRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "humanApprovalGates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sourceReference": { "type": "string" }
  }
}

